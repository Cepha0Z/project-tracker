rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/authProfiles/$(request.auth.uid);
    }

    function activeUser() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }

    function userId() {
      return get(profilePath()).data.userId;
    }

    function isAdmin() {
      return activeUser() && get(profilePath()).data.access == 'admin';
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function futureProject(projectId) {
      return getAfter(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function workItem(workItemId) {
      return get(/databases/$(database)/documents/workItems/$(workItemId)).data;
    }

    function isProjectMember(projectId) {
      return isAdmin() || project(projectId).principalId == userId()
        || project(projectId).leadId == userId()
        || project(projectId).teamIds.hasAny([userId()]);
    }

    function canManageProject(projectId) {
      return isAdmin() || project(projectId).leadId == userId();
    }

    function canManageFutureProject(projectId) {
      return isAdmin() || futureProject(projectId).leadId == userId();
    }

    function isProjectPrincipal(projectId) {
      return isAdmin() || project(projectId).principalId == userId()
        || (
          project(projectId).keys().hasAny(['principalIds'])
          && project(projectId).principalIds.hasAny([userId()])
        );
    }

    function isWorkItemAssignee(workItemId) {
      return workItem(workItemId).assigneeId == userId()
        || (
          workItem(workItemId).keys().hasAny(['assigneeIds'])
          && workItem(workItemId).assigneeIds.hasAny([userId()])
        );
    }

    function unchangedHelpIdentity() {
      return request.resource.data.projectId == resource.data.projectId
        && request.resource.data.workItemId == resource.data.workItemId
        && request.resource.data.raisedBy == resource.data.raisedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.kind == resource.data.kind;
    }

    function ownsNotificationDevice(device) {
      return activeUser()
        && device.userId == userId()
        && device.authUid == request.auth.uid;
    }

    function validNotificationDevicePath(deviceId, device) {
      return deviceId == request.auth.uid + '_' + device.installationId;
    }

    match /authProfiles/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /notificationDevices/{deviceId} {
      // registerDevice() checks this exact UID-prefixed document before creating it.
      // Collection listing is unnecessary for clients; the authenticated Worker uses server credentials.
      allow get: if activeUser()
        && deviceId.matches(request.auth.uid + '_.*');
      allow list: if false;
      allow create: if ownsNotificationDevice(request.resource.data)
        && validNotificationDevicePath(deviceId, request.resource.data)
        && request.resource.data.enabled == true
        && request.resource.data.keys().hasAll([
          'userId', 'authUid', 'installationId', 'token', 'platform',
          'browser', 'enabled', 'createdAt', 'lastSeenAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'authUid', 'installationId', 'token', 'platform',
          'browser', 'enabled', 'createdAt', 'lastSeenAt'
        ]);
      allow update: if ownsNotificationDevice(resource.data)
        && ownsNotificationDevice(request.resource.data)
        && validNotificationDevicePath(deviceId, resource.data)
        && validNotificationDevicePath(deviceId, request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.installationId == resource.data.installationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'token', 'platform', 'browser', 'enabled', 'lastSeenAt'
        ]);
      allow delete: if ownsNotificationDevice(resource.data)
        && validNotificationDevicePath(deviceId, resource.data);
    }

    match /users/{id} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /projects/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && (isAdmin() || (
        request.resource.data.createdBy == userId()
        && request.resource.data.teamIds.hasAny([userId()])
      )) && request.resource.data.teamIds.hasAny([request.resource.data.leadId]);
      allow update: if canManageProject(id)
        && request.resource.data.teamIds.hasAny([request.resource.data.leadId]);
      allow delete: if isAdmin();
    }

    match /workItems/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && canManageFutureProject(request.resource.data.projectId)
        && futureProject(request.resource.data.projectId).teamIds.hasAll(request.resource.data.assigneeIds)
        && request.resource.data.assigneeIds.hasAny([request.resource.data.assigneeId]);
      allow update: if activeUser()
        && request.resource.data.projectId == resource.data.projectId
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigneeId', 'assigneeIds'])
          || (
            project(resource.data.projectId).teamIds.hasAny([request.resource.data.assigneeId])
            && (
              !request.resource.data.keys().hasAny(['assigneeIds'])
              || project(resource.data.projectId).teamIds.hasAll(request.resource.data.assigneeIds)
            )
          )
        )
        && (
        (canManageProject(resource.data.projectId) && resource.data.status != 'Blocked')
        || (
          isWorkItemAssignee(id)
          && resource.data.status != 'Blocked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'dueDate', 'dueLabel', 'scopeNotes', 'notes', 'status',
            'progress', 'blockedReason', 'startedAt', 'completedAt',
            'activeElapsedMinutes', 'previousProgress', 'updatedAt'
          ])
        )
        || (
          isProjectPrincipal(resource.data.projectId)
          && resource.data.status == 'Blocked'
          && request.resource.data.status == 'In Progress'
          && request.resource.data.progress == resource.data.progress
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'blockedReason', 'startedAt', 'updatedAt'
          ])
        )
      );
      allow delete: if activeUser() && canManageProject(resource.data.projectId);
    }

    match /dailyUpdates/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.userId == userId();
      allow update: if activeUser() && resource.data.userId == userId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
      allow delete: if isAdmin();
    }

    match /dailyReports/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.userId == userId();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /helpRequests/{id} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.raisedBy == userId()
        && isProjectMember(request.resource.data.projectId)
        && request.resource.data.projectId == workItem(request.resource.data.workItemId).projectId
        && isWorkItemAssignee(request.resource.data.workItemId)
        && workItem(request.resource.data.workItemId).status != 'Completed'
        && (!(workItem(request.resource.data.workItemId).keys().hasAny(['archived']))
          || workItem(request.resource.data.workItemId).archived == false)
        && request.resource.data.kind in ['question', 'blocked']
        && (request.resource.data.kind != 'blocked'
          || getAfter(/databases/$(database)/documents/workItems/$(request.resource.data.workItemId)).data.status == 'Blocked')
        && request.resource.data.id == id
        && request.resource.data.level == 'lead'
        && request.resource.data.status == 'Open'
        && request.resource.data.assignedTo == project(request.resource.data.projectId).leadId
        && request.resource.data.keys().hasAll([
          'id', 'projectId', 'workItemId', 'raisedBy', 'assignedTo',
          'level', 'subject', 'reason', 'priority', 'status', 'createdAt', 'kind'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'projectId', 'workItemId', 'raisedBy', 'assignedTo',
          'level', 'subject', 'reason', 'priority', 'status', 'createdAt', 'kind'
        ]);
      allow update: if activeUser()
        && unchangedHelpIdentity()
        && (
          (
            project(resource.data.projectId).leadId == userId()
            && resource.data.level == 'lead'
            && resource.data.status in ['Open', 'Responded']
            && request.resource.data.level == 'lead'
            && request.resource.data.assignedTo == resource.data.assignedTo
            && request.resource.data.status == 'Responded'
            && request.resource.data.respondedBy == userId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'response', 'respondedBy', 'respondedAt'
            ])
          )
          || (
            (project(resource.data.projectId).leadId == userId() || isWorkItemAssignee(resource.data.workItemId))
            && resource.data.level == 'lead'
            && resource.data.status in ['Open', 'Responded']
            && request.resource.data.level == 'principal'
            && request.resource.data.status == 'Escalated'
            && request.resource.data.assignedTo == project(resource.data.projectId).principalId
            && request.resource.data.escalatedBy == userId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'level', 'assignedTo', 'escalationNote', 'status', 'escalatedBy', 'escalatedAt'
            ])
          )
          || (
            isProjectPrincipal(resource.data.projectId)
            && resource.data.level == 'lead'
            && resource.data.status != 'Resolved'
            && request.resource.data.level == 'lead'
            && request.resource.data.status == 'Resolved'
            && request.resource.data.resolvedBy == userId()
            && request.resource.data.resolutionNote is string
            && request.resource.data.resolutionNote.size() > 0
            && request.resource.data.response == request.resource.data.resolutionNote
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'response', 'resolutionNote', 'resolvedBy', 'resolvedAt'
            ])
          )
          || (
            isProjectPrincipal(resource.data.projectId)
            && resource.data.level == 'principal'
            && resource.data.status in ['Escalated', 'Seen']
            && request.resource.data.level == 'principal'
            && request.resource.data.status == 'Seen'
            && resource.data.status == 'Escalated'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
          || (
            isProjectPrincipal(resource.data.projectId)
            && resource.data.level == 'principal'
            && resource.data.status in ['Escalated', 'Seen']
            && request.resource.data.level == 'principal'
            && request.resource.data.status == 'Decision Given'
            && request.resource.data.decidedBy == userId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'assignedTo', 'principalDecision', 'decisionOutcome',
              'decidedBy', 'decidedAt'
            ])
          )
          || (
            isProjectPrincipal(resource.data.projectId)
            && resource.data.level == 'principal'
            && resource.data.status in ['Escalated', 'Seen', 'Decision Given']
            && request.resource.data.level == 'principal'
            && request.resource.data.status == 'Resolved'
            && request.resource.data.resolvedBy == userId()
            && request.resource.data.resolutionNote is string
            && request.resource.data.resolutionNote.size() > 0
            && request.resource.data.response == request.resource.data.resolutionNote
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'response', 'resolutionNote', 'resolvedBy', 'resolvedAt'
            ])
          )
        );
      allow delete: if isAdmin();
    }

    match /activity/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.actorId == userId();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /cycles/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && canManageFutureProject(request.resource.data.projectId);
      allow update, delete: if activeUser() && canManageProject(resource.data.projectId);
    }

    match /timeEntries/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.userId == userId();
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
