rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/authProfiles/$(request.auth.uid);
    }

    function activeUser() {
      return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true;
    }

    function userId() {
      return get(profilePath()).data.userId;
    }

    function isAdmin() {
      return activeUser() && get(profilePath()).data.access == 'admin';
    }

    function isLinkedAdminUser(id) {
      let person = get(/databases/$(database)/documents/users/$(id)).data;
      return person.access == 'admin'
        && (!person.keys().hasAny(['active']) || person.active == true)
        && person.authUid is string
        && get(/databases/$(database)/documents/authProfiles/$(person.authUid)).data.userId == id
        && get(/databases/$(database)/documents/authProfiles/$(person.authUid)).data.access == 'admin'
        && get(/databases/$(database)/documents/authProfiles/$(person.authUid)).data.active == true;
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function futureProject(projectId) {
      return getAfter(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function workItem(workItemId) {
      return get(/databases/$(database)/documents/workItems/$(workItemId)).data;
    }

    function isProjectMember(projectId) {
      return isAdmin() || project(projectId).principalId == userId()
        || project(projectId).leadId == userId()
        || project(projectId).teamIds.hasAny([userId()]);
    }

    function canManageProject(projectId) {
      return isAdmin() || project(projectId).leadId == userId();
    }

    function canManageFutureProject(projectId) {
      return isAdmin() || futureProject(projectId).leadId == userId();
    }

    function isProjectPrincipal(projectId) {
      return isAdmin() || project(projectId).principalId == userId()
        || (
          project(projectId).keys().hasAny(['principalIds'])
          && project(projectId).principalIds.hasAny([userId()])
        );
    }

    function isWorkItemAssignee(workItemId) {
      return workItem(workItemId).assigneeId == userId()
        || (
          workItem(workItemId).keys().hasAny(['assigneeIds'])
          && workItem(workItemId).assigneeIds.hasAny([userId()])
        );
    }

    function existingAssignees(item) {
      return item.keys().hasAny(['assigneeIds']) && item.assigneeIds.size() > 0
        ? item.assigneeIds : [item.assigneeId];
    }

    function unchangedHelpIdentity() {
      return request.resource.data.projectId == resource.data.projectId
        && request.resource.data.workItemId == resource.data.workItemId
        && request.resource.data.raisedBy == resource.data.raisedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.subject == resource.data.subject
        && request.resource.data.kind == resource.data.kind;
    }

    function canCloseHelpRequest(help) {
      return isProjectMember(help.projectId) || help.raisedBy == userId();
    }

    function closesBlockedHelpFor(workItemId, projectId, helpId) {
      let before = get(/databases/$(database)/documents/helpRequests/$(helpId)).data;
      let after = getAfter(/databases/$(database)/documents/helpRequests/$(helpId)).data;
      return before.workItemId == workItemId
        && before.projectId == projectId
        && before.kind == 'blocked'
        && before.status != 'Resolved'
        && after.status == 'Resolved'
        && after.resolvedBy == userId();
    }

    function ownsNotificationDevice(device) {
      return activeUser()
        && device.userId == userId()
        && device.authUid == request.auth.uid;
    }

    function validNotificationDevicePath(deviceId, device) {
      return deviceId == request.auth.uid + '_' + device.installationId;
    }

    function validMeetingData(meetingId, projectId) {
      let meeting = request.resource.data;
      return meeting.keys().hasAll(['id', 'date', 'title', 'projectId', 'attendeeIds', 'notes', 'createdBy', 'createdAt'])
        && meeting.keys().hasOnly(['id', 'date', 'title', 'projectId', 'attendeeIds', 'notes', 'createdBy', 'createdAt', 'type', 'groupId'])
        && meeting.id == meetingId
        && meeting.projectId == projectId
        && (meeting.createdBy == userId() || isAdmin())
        && meeting.createdAt is timestamp
        && meeting.date is string
        && meeting.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && meeting.title is string && meeting.title.size() > 0 && meeting.title.size() <= 160
        && meeting.notes is string && meeting.notes.size() <= 20000
        && meeting.attendeeIds is list && meeting.attendeeIds.size() <= 100
        && (!meeting.keys().hasAny(['type']) || meeting.type in ['Client', 'Internal', 'Vendor', 'Other'])
        && (!meeting.keys().hasAny(['groupId']) || (
          projectId == null
          && meeting.groupId is string
          && exists(/databases/$(database)/documents/meetingGroups/$(meeting.groupId))
        ));
    }

    function validMeetingUpdateData(meetingId, projectId) {
      return validMeetingData(meetingId, projectId)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'date', 'title', 'projectId', 'attendeeIds', 'notes', 'type', 'groupId'
        ]);
    }

    function validMeetingGroup(groupId) {
      let group = request.resource.data;
      return group.keys().hasAll(['id', 'name', 'createdBy', 'createdAt'])
        && group.keys().hasOnly(['id', 'name', 'createdBy', 'createdAt'])
        && group.id == groupId
        && group.name is string && group.name.size() > 0 && group.name.size() <= 80
        && group.createdBy == userId()
        && group.createdAt is timestamp;
    }

    match /authProfiles/{uid} {
      allow read: if activeUser() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /notificationDevices/{deviceId} {
      // registerDevice() checks this exact UID-prefixed document before creating it.
      // Collection listing is unnecessary for clients; the authenticated Worker uses server credentials.
      allow get: if activeUser()
        && deviceId.matches(request.auth.uid + '_.*');
      allow list: if false;
      allow create: if ownsNotificationDevice(request.resource.data)
        && validNotificationDevicePath(deviceId, request.resource.data)
        && request.resource.data.enabled == true
        && request.resource.data.keys().hasAll([
          'userId', 'authUid', 'installationId', 'token', 'platform',
          'browser', 'enabled', 'createdAt', 'lastSeenAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'authUid', 'installationId', 'token', 'platform',
          'browser', 'enabled', 'createdAt', 'lastSeenAt'
        ]);
      allow update: if ownsNotificationDevice(resource.data)
        && ownsNotificationDevice(request.resource.data)
        && validNotificationDevicePath(deviceId, resource.data)
        && validNotificationDevicePath(deviceId, request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.installationId == resource.data.installationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'token', 'platform', 'browser', 'enabled', 'lastSeenAt'
        ]);
      allow delete: if ownsNotificationDevice(resource.data)
        && validNotificationDevicePath(deviceId, resource.data);
    }

    match /users/{id} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /projects/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && (isAdmin() || (
        request.resource.data.createdBy == userId()
        && request.resource.data.teamIds.hasAny([userId()])
      )) && request.resource.data.teamIds.hasAny([request.resource.data.leadId])
        && (!request.resource.data.keys().hasAny(['archived']) || request.resource.data.archived == false);
      allow update: if activeUser() && request.resource.data.teamIds.hasAny([request.resource.data.leadId])
        && ((canManageProject(id)
          && (isAdmin() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['archived', 'archivedAt', 'archivedBy']))) || (
          isProjectMember(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stages', 'currentStage'])
          && request.resource.data.stages is list
          && request.resource.data.stages.size() > 0
          && request.resource.data.stages.size() <= 50
        ));
      allow delete: if isAdmin();
    }

    match /projects/{projectId}/meetings/{meetingId} {
      allow read: if activeUser() && isProjectMember(projectId);
      allow create: if activeUser() && isProjectMember(projectId) && validMeetingData(meetingId, projectId);
      allow update: if activeUser() && (resource.data.createdBy == userId() || isAdmin())
        && validMeetingUpdateData(meetingId, projectId);
      allow delete: if activeUser() && (resource.data.createdBy == userId() || isAdmin());
    }

    match /generalMeetings/{meetingId} {
      allow read: if activeUser();
      allow create: if activeUser() && validMeetingData(meetingId, null);
      allow update: if activeUser() && (resource.data.createdBy == userId() || isAdmin())
        && validMeetingUpdateData(meetingId, null);
      allow delete: if activeUser() && (resource.data.createdBy == userId() || isAdmin());
    }

    match /meetingGroups/{groupId} {
      allow read: if activeUser();
      allow create: if activeUser() && validMeetingGroup(groupId);
      allow update: if isAdmin()
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);
      allow delete: if isAdmin();
    }

    match /workItems/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && isProjectMember(request.resource.data.projectId)
        && futureProject(request.resource.data.projectId).teamIds.hasAll(request.resource.data.assigneeIds)
        && request.resource.data.assigneeIds.hasAny([request.resource.data.assigneeId]);
      allow update: if activeUser()
        && request.resource.data.projectId == resource.data.projectId
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigneeId', 'assigneeIds'])
          || (
            project(resource.data.projectId).teamIds.hasAny([request.resource.data.assigneeId])
            && (
              !request.resource.data.keys().hasAny(['assigneeIds'])
              || project(resource.data.projectId).teamIds.hasAll(request.resource.data.assigneeIds)
            )
          )
        )
        && (
        (canManageProject(resource.data.projectId) && resource.data.status != 'Blocked')
        || (
          canManageProject(resource.data.projectId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sortOrder', 'archived', 'updatedAt'
          ])
        )
        || (
          isProjectMember(resource.data.projectId)
          && request.resource.data.stage == request.resource.data.stageId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'stageId'])
        )
        || (
          isWorkItemAssignee(id)
          && resource.data.status != 'Blocked'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'dueDate', 'dueLabel', 'scopeNotes', 'notes', 'status',
            'progress', 'blockedReason', 'startedAt', 'completedAt',
            'activeElapsedMinutes', 'previousProgress', 'updatedAt'
          ])
        )
        || (
          get(profilePath()).data.access == 'employee'
          && resource.data.status != 'Completed'
          && (!resource.data.keys().hasAny(['archived']) || resource.data.archived == false)
          && isProjectMember(resource.data.projectId)
          && !isWorkItemAssignee(id)
          && request.resource.data.assigneeId == resource.data.assigneeId
          && request.resource.data.assigneeIds.size() == existingAssignees(resource.data).size() + 1
          && request.resource.data.assigneeIds.hasAll(existingAssignees(resource.data))
          && request.resource.data.assigneeIds.hasAny([userId()])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneeIds', 'updatedAt'])
        )
        || (
          isProjectPrincipal(resource.data.projectId)
          && resource.data.status == 'Blocked'
          && request.resource.data.status == 'In Progress'
          && request.resource.data.progress == resource.data.progress
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'blockedReason', 'startedAt', 'updatedAt'
          ])
        )
        || (
          resource.data.status == 'Blocked'
          && request.resource.data.status == 'In Progress'
          && request.resource.data.progress == resource.data.progress
          && request.resource.data.keys().hasAny(['unblockedByHelpId'])
          && closesBlockedHelpFor(id, resource.data.projectId, request.resource.data.unblockedByHelpId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'blockedReason', 'startedAt', 'updatedAt', 'unblockedByHelpId'
          ])
        )
      );
      allow delete: if activeUser() && canManageProject(resource.data.projectId);
    }

    match /dailyUpdates/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.userId == userId();
      allow update: if activeUser() && resource.data.userId == userId()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text']);
      allow delete: if activeUser() && (resource.data.userId == userId() || isAdmin())
        && (
          !resource.data.keys().hasAny(['reportId'])
          || !existsAfter(/databases/$(database)/documents/dailyReports/$(resource.data.reportId))
        );
    }

    match /dailyReports/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.userId == userId();
      // An admin removing a project may trim only that project's entries from
      // a report spanning multiple projects; the remaining history stays intact.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updateIds', 'items'])
        && (
          request.resource.data.updateIds.size() > 0
          || (
            request.resource.data.keys().hasAny(['customWork'])
            && request.resource.data.customWork is string
            && request.resource.data.customWork.size() > 0
          )
        )
        && resource.data.updateIds.hasAll(request.resource.data.updateIds)
        && request.resource.data.updateIds.size() < resource.data.updateIds.size()
        && (
          !resource.data.keys().hasAny(['items'])
          || (
            request.resource.data.keys().hasAny(['items'])
            && resource.data.items.hasAll(request.resource.data.items)
          )
        );
      allow delete: if activeUser() && (resource.data.userId == userId() || isAdmin());
    }

    match /helpRequests/{id} {
      allow read: if activeUser();
      allow create: if activeUser()
        && get(profilePath()).data.access == 'employee'
        && request.resource.data.raisedBy == userId()
        && isProjectMember(request.resource.data.projectId)
        && request.resource.data.projectId == workItem(request.resource.data.workItemId).projectId
        && isWorkItemAssignee(request.resource.data.workItemId)
        && workItem(request.resource.data.workItemId).status != 'Completed'
        && (!(workItem(request.resource.data.workItemId).keys().hasAny(['archived']))
          || workItem(request.resource.data.workItemId).archived == false)
        && request.resource.data.kind == 'question'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.id == id
        && request.resource.data.level == 'principal'
        && request.resource.data.status == 'Open'
        && isLinkedAdminUser(request.resource.data.assignedTo)
        && request.resource.data.keys().hasAll([
          'id', 'projectId', 'workItemId', 'raisedBy', 'assignedTo',
          'level', 'subject', 'reason', 'priority', 'status', 'createdAt', 'kind'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'projectId', 'workItemId', 'raisedBy', 'assignedTo',
          'level', 'subject', 'reason', 'priority', 'status', 'createdAt', 'kind'
        ]);
      allow update: if activeUser()
        && unchangedHelpIdentity()
        && (
          (
            project(resource.data.projectId).leadId == userId()
            && resource.data.level == 'lead'
            && resource.data.status in ['Open', 'Responded']
            && request.resource.data.level == 'lead'
            && request.resource.data.assignedTo == resource.data.assignedTo
            && request.resource.data.status == 'Responded'
            && request.resource.data.respondedBy == userId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'response', 'respondedBy', 'respondedAt'
            ])
          )
          || (
            get(profilePath()).data.access == 'employee'
            && isWorkItemAssignee(resource.data.workItemId)
            && resource.data.level == 'lead'
            && resource.data.status in ['Open', 'Responded']
            && request.resource.data.level == 'principal'
            && request.resource.data.status == 'Escalated'
            && isLinkedAdminUser(request.resource.data.assignedTo)
            && request.resource.data.escalatedBy == userId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'level', 'assignedTo', 'escalationNote', 'status', 'escalatedBy', 'escalatedAt'
            ])
          )
          || (
            get(profilePath()).data.access == 'employee'
            && isWorkItemAssignee(resource.data.workItemId)
            && resource.data.level == 'principal'
            && resource.data.status in ['Open', 'Responded']
            && request.resource.data.level == 'principal'
            && request.resource.data.status == 'Escalated'
            && request.resource.data.assignedTo == resource.data.assignedTo
            && request.resource.data.escalatedBy == userId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'escalationNote', 'status', 'escalatedBy', 'escalatedAt'
            ])
          )
          || (
            isAdmin()
            && resource.data.level == 'principal'
            && resource.data.status in ['Escalated', 'Seen']
            && request.resource.data.level == 'principal'
            && request.resource.data.status == 'Seen'
            && resource.data.status == 'Escalated'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          )
          || (
            isAdmin()
            && resource.data.level == 'principal'
            && resource.data.status in ['Escalated', 'Seen']
            && request.resource.data.level == 'principal'
            && request.resource.data.status == 'Decision Given'
            && request.resource.data.decidedBy == userId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'assignedTo', 'principalDecision', 'decisionOutcome',
              'decidedBy', 'decidedAt'
            ])
          )
          || (
            canCloseHelpRequest(resource.data)
            && resource.data.status in ['Open', 'Responded', 'Escalated', 'Seen', 'Decision Given']
            && request.resource.data.level == resource.data.level
            && request.resource.data.assignedTo == resource.data.assignedTo
            && request.resource.data.status == 'Resolved'
            && request.resource.data.resolvedBy == userId()
            && request.resource.data.resolvedAt is timestamp
            && request.resource.data.resolutionNote is string
            && request.resource.data.resolutionNote.size() > 0
            && request.resource.data.response == (
              resource.data.keys().hasAny(['response'])
                ? resource.data.response : request.resource.data.resolutionNote
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'response', 'resolutionNote', 'resolvedBy', 'resolvedAt'
            ])
          )
        );
      allow delete: if isAdmin() || (activeUser() && canManageProject(resource.data.projectId));
    }

    match /activity/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.actorId == userId();
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /cycles/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && canManageFutureProject(request.resource.data.projectId);
      allow update, delete: if activeUser() && canManageProject(resource.data.projectId);
    }

    match /timeEntries/{id} {
      allow read: if activeUser();
      allow create: if activeUser() && request.resource.data.userId == userId();
      allow update: if false;
      allow delete: if activeUser() && (resource.data.userId == userId() || isAdmin());
    }

    match /attendanceEntries/{id} {
      allow read: if activeUser() && (resource.data.userId == userId() || isAdmin());
      allow create: if activeUser()
        && request.resource.data.keys().hasAll(['id', 'userId', 'clockInAt'])
        && request.resource.data.keys().hasOnly(['id', 'userId', 'clockInAt'])
        && request.resource.data.id == id
        && request.resource.data.userId == userId()
        && request.resource.data.clockInAt is timestamp;
      allow update: if activeUser()
        && resource.data.userId == userId()
        && request.resource.data.id == resource.data.id
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.clockInAt == resource.data.clockInAt
        && !resource.data.keys().hasAny(['clockOutAt'])
        && request.resource.data.clockOutAt is timestamp
        && request.resource.data.clockOutAt >= resource.data.clockInAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clockOutAt']);
      allow delete: if false;
    }
  }
}
